{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Start Backend Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/index.js",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🧪 Run API Tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/test-api.js",
      "console": "integratedTerminal"
    },
    {
      "name": "🌱 Re-seed Database",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/database/seed.js",
      "console": "integratedTerminal"
    }
  ]
}
